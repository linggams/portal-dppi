// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  idRole      Int     @id @default(autoincrement()) @map("id_role")
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String  @default("") @db.VarChar(255)
  isSystem    Boolean @default(false) @map("is_system")
  homePath    String  @map("home_path") @db.VarChar(100)

  canAccessPlatform           Boolean @default(false) @map("can_access_platform")
  canAccessPurchasingUser     Boolean @default(false) @map("can_access_purchasing_user")
  canHandlePurchasingWorkflow Boolean @default(false) @map("can_handle_purchasing_workflow")
  canManagePurchasingMaster   Boolean @default(false) @map("can_manage_purchasing_master")
  canAccessItUser             Boolean @default(false) @map("can_access_it_user")
  canAccessItStaff            Boolean @default(false) @map("can_access_it_staff")

  users User[]

  @@map("role")
}

model User {
  idUser   Int       @id @default(autoincrement()) @map("id_user")
  username String    @unique @db.VarChar(20)
  password String    @db.VarChar(255)
  level    UserLevel
  jabatan  String    @db.VarChar(50)
  roleId   Int       @map("id_role")
  managePurchasing Boolean @default(false) @map("manage_purchasing")
  manageIt         Boolean @default(false) @map("manage_it")
  manageDana       Boolean @default(false) @map("manage_dana")
  manageMobil      Boolean @default(false) @map("manage_mobil")
  accessPurchasing Boolean @default(false) @map("access_purchasing")
  accessIt         Boolean @default(false) @map("access_it")
  accessDana       Boolean @default(false) @map("access_dana")
  accessMobil      Boolean @default(false) @map("access_mobil")

  role Role @relation(fields: [roleId], references: [idRole], onDelete: Restrict)

  @@index([roleId])
  @@map("user")
}

enum UserLevel {
  user
  administrator
  it_support
  purchasing
}

model JenisBarang {
  idJenis   Int    @id @default(autoincrement()) @map("id_jenis")
  jenisBrg  String @map("jenis_brg") @db.VarChar(255)

  stokbarang Stokbarang[]

  @@map("atk_jenis_barang")
}

model Stokbarang {
  idKodeBrg   Int    @id @default(autoincrement()) @map("id_kode_brg")
  kodeBrg     String @unique @map("kode_brg") @db.VarChar(7)
  idJenis     Int    @map("id_jenis")
  namaBrg     String @map("nama_brg") @db.VarChar(50)
  hargabarang String @db.VarChar(50)
  satuan      String @db.VarChar(50)
  stok        Int
  keluar      Int    @default(0)
  sisa        Int    @default(0)
  keterangan  String @default("") @db.VarChar(50)

  jenisBarang JenisBarang @relation(fields: [idJenis], references: [idJenis], onDelete: Restrict)
  permintaan  Permintaan[]
  pengajuan   Pengajuan[]
  pengajuanSementara PengajuanSementara[]
  sementara   Sementara[]
  pemasukan   Pemasukan[]
  pengeluaran Pengeluaran[]

  @@map("atk_stokbarang")
}

model Permintaan {
  idPermintaan Int      @id @default(autoincrement()) @map("id_permintaan")
  unit         String   @db.VarChar(20)
  user     String   @db.VarChar(20)
  kodeBrg      String   @map("kode_brg") @db.VarChar(7)
  idJenis      Int      @map("id_jenis")
  jumlah       Int
  tglPermintaan DateTime @map("tgl_permintaan") @db.Date
  status       Int      @default(0)

  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_permintaan")
  @@index([unit, tglPermintaan])
  @@index([status])
}

model Sementara {
  idSementara  Int      @id @default(autoincrement()) @map("id_sementara")
  unit         String   @db.VarChar(50)
  user     String   @db.VarChar(20)
  kodeBrg      String   @map("kode_brg") @db.VarChar(7)
  idJenis      Int      @map("id_jenis")
  jumlah       Int
  tglPermintaan DateTime @map("tgl_permintaan") @db.Date
  status       Int      @default(0)

  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_sementara")
  @@index([unit, tglPermintaan])
}

model Pengajuan {
  idPengajuan Int      @id @default(autoincrement()) @map("id_pengajuan")
  unit        String   @db.VarChar(20)
  kodeBrg     String   @map("kode_brg") @db.VarChar(7)
  idJenis     Int      @map("id_jenis")
  jumlah      Int
  satuan      String   @db.VarChar(11)
  hargabarang Float    @db.DoublePrecision
  total       Float    @db.DoublePrecision
  tglPengajuan DateTime @map("tgl_pengajuan") @db.Date
  status      Int      @default(0)

  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_pengajuan")
  @@index([unit, tglPengajuan])
  @@index([status])
}

model PengajuanSementara {
  idPengajuanSementara Int      @id @default(autoincrement()) @map("id_pengajuan_sementara")
  unit                 String   @db.VarChar(20)
  kodeBrg              String   @map("kode_brg") @db.VarChar(7)
  idJenis              Int      @map("id_jenis")
  jumlah               Int
  satuan               String   @db.VarChar(20)
  hargabarang          Float    @db.DoublePrecision
  total                Float    @db.DoublePrecision
  tglPengajuan         DateTime @map("tgl_pengajuan") @db.Date
  status               Int      @default(0)

  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_pengajuan_sementara")
  @@index([unit, tglPengajuan])
}

model Pemasukan {
  id       Int      @id @default(autoincrement())
  unit    String   @db.VarChar(30)
  kodeBrg String   @map("kode_brg") @db.VarChar(7)
  jumlah  Int
  tglMasuk DateTime @map("tgl_masuk") @db.Date

  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_pemasukan")
  @@index([tglMasuk])
  @@index([unit])
}

model Pengeluaran {
  id       Int      @id @default(autoincrement())
  unit    String   @db.VarChar(20)
  kodeBrg String   @map("kode_brg") @db.VarChar(7)
  jumlah  Int
  tglKeluar DateTime @map("tgl_keluar") @db.Date

  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_pengeluaran")
  @@index([tglKeluar])
  @@index([unit])
}

model ItTiketKategori {
  idKategori Int      @id @default(autoincrement()) @map("id_kategori")
  nama       String   @db.VarChar(100)
  aktif      Boolean  @default(true)
  tiket      ItTiket[]
  maintenanceLog ItMaintenanceLog[]

  @@map("it_tiket_kategori")
}

model ItTiket {
  idTiket      Int       @id @default(autoincrement()) @map("id_tiket")
  nomorTiket   String    @unique @map("nomor_tiket") @db.VarChar(20)
  username     String    @db.VarChar(20)
  jabatan      String    @db.VarChar(50)
  judul        String    @db.VarChar(200)
  deskripsi    String    @db.Text
  idKategori   Int       @map("id_kategori")
  status       Int       @default(0)
  ditugaskanKe String?   @map("ditugaskan_ke") @db.VarChar(20)
  tglDibuat    DateTime  @default(now()) @map("tgl_dibuat")
  tglDiupdate  DateTime  @updatedAt @map("tgl_diupdate")
  tglSelesai   DateTime? @map("tgl_selesai")

  kategori ItTiketKategori  @relation(fields: [idKategori], references: [idKategori])
  komentar ItTiketKomentar[]
  maintenanceLog ItMaintenanceLog[]

  @@map("it_tiket")
  @@index([username])
  @@index([status])
  @@index([ditugaskanKe])
  @@index([tglDibuat])
}

model ItTiketKomentar {
  idKomentar Int      @id @default(autoincrement()) @map("id_komentar")
  idTiket    Int      @map("id_tiket")
  username   String   @db.VarChar(20)
  pesan      String   @db.Text
  tipe       String   @default("komentar") @db.VarChar(20)
  tglDibuat  DateTime @default(now()) @map("tgl_dibuat")

  tiket ItTiket @relation(fields: [idTiket], references: [idTiket], onDelete: Cascade)

  @@map("it_tiket_komentar")
  @@index([idTiket])
}

model ItMaintenanceLog {
  idMaintenance  Int      @id @default(autoincrement()) @map("id_maintenance")
  idKategori     Int      @map("id_kategori")
  username       String   @db.VarChar(20)
  tglKerja       DateTime @map("tgl_kerja")
  jenisPekerjaan String?  @map("jenis_pekerjaan") @db.VarChar(30)
  lokasi         String?  @db.VarChar(100)
  judul          String   @db.VarChar(200)
  uraian         String   @db.Text
  durasiMenit    Int?     @map("durasi_menit")
  hasil          String   @default("selesai") @db.VarChar(30)
  idTiket        Int?     @map("id_tiket")
  tglDibuat      DateTime @default(now()) @map("tgl_dibuat")

  kategori ItTiketKategori @relation(fields: [idKategori], references: [idKategori])
  tiket    ItTiket?         @relation(fields: [idTiket], references: [idTiket], onDelete: SetNull)

  @@map("it_maintenance_log")
  @@index([idKategori])
  @@index([username])
  @@index([tglKerja])
  @@index([idTiket])
}

model DanaPengajuan {
  idPengajuan   Int       @id @default(autoincrement()) @map("id_pengajuan")
  nomor         String    @unique @db.VarChar(20)
  username      String    @db.VarChar(20)
  jabatan       String    @db.VarChar(50)
  nominal       Int
  kembalian     Int       @default(0)
  keperluan     String    @db.Text
  status        Int       @default(0)
  alasanTolak   String?   @map("alasan_tolak") @db.Text
  disetujuiOleh String?   @map("disetujui_oleh") @db.VarChar(20)
  tglDisetujui  DateTime? @map("tgl_disetujui")
  tglDibuat     DateTime  @default(now()) @map("tgl_dibuat")
  tglDiupdate   DateTime  @updatedAt @map("tgl_diupdate")

  @@map("dana_pengajuan")
  @@index([username])
  @@index([status])
  @@index([tglDibuat])
}

model MobilJenis {
  idJenis     Int    @id @default(autoincrement()) @map("id_jenis")
  nama        String @db.VarChar(100)
  keterangan  String @default("") @db.VarChar(255)

  kendaraan MobilKendaraan[]

  @@map("mobil_jenis")
}

model MobilKendaraan {
  idKendaraan Int      @id @default(autoincrement()) @map("id_kendaraan")
  nopol       String   @unique @db.VarChar(20)
  idJenis     Int      @map("id_jenis")
  kmAwal      Int      @default(0) @map("km_awal")
  aktif       Boolean  @default(true)
  tglDibuat   DateTime @default(now()) @map("tgl_dibuat")
  tglDiupdate DateTime @updatedAt @map("tgl_diupdate")

  jenis   MobilJenis       @relation(fields: [idJenis], references: [idJenis], onDelete: Restrict)
  laporan MobilLaporanKm[]

  @@map("mobil_kendaraan")
  @@index([idJenis])
  @@index([aktif])
}

model MobilLaporanKm {
  idLaporan   Int      @id @default(autoincrement()) @map("id_laporan")
  idKendaraan Int      @map("id_kendaraan")
  username    String   @db.VarChar(20)
  jabatan     String   @db.VarChar(50)
  tanggal     DateTime @db.Date
  kmAwal      Int      @map("km_awal")
  kmAkhir     Int      @map("km_akhir")
  keterangan  String   @default("") @db.Text
  buktiPath   String   @map("bukti_path") @db.VarChar(255)
  tglDibuat   DateTime @default(now()) @map("tgl_dibuat")
  tglDiupdate DateTime @updatedAt @map("tgl_diupdate")

  kendaraan MobilKendaraan @relation(fields: [idKendaraan], references: [idKendaraan], onDelete: Restrict)

  @@unique([idKendaraan, tanggal])
  @@map("mobil_laporan_km")
  @@index([username])
  @@index([tanggal])
  @@index([idKendaraan])
}
