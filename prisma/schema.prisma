// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  idRole      Int     @id @default(autoincrement()) @map("id_role")
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String  @default("") @db.VarChar(255)
  isSystem    Boolean @default(false) @map("is_system")
  homePath    String  @map("home_path") @db.VarChar(100)

  canAccessPlatform           Boolean @default(false) @map("can_access_platform")
  canAccessPurchasingUser     Boolean @default(false) @map("can_access_purchasing_user")
  canHandlePurchasingWorkflow Boolean @default(false) @map("can_handle_purchasing_workflow")
  canManagePurchasingMaster   Boolean @default(false) @map("can_manage_purchasing_master")

  users User[]

  @@map("role")
}

model User {
  idUser   Int       @id @default(autoincrement()) @map("id_user")
  username String    @unique @db.VarChar(20)
  password String    @db.VarChar(255)
  email    String?   @db.VarChar(120)
  level    UserLevel
  jabatan  String    @db.VarChar(50)
  roleId   Int       @map("id_role")
  managePurchasing Boolean @default(false) @map("manage_purchasing")
  manageItms       Boolean @default(false) @map("manage_itms")
  manageMobil      Boolean @default(false) @map("manage_mobil")
  accessPurchasing Boolean @default(false) @map("access_purchasing")
  accessItms       Boolean @default(false) @map("access_itms")
  accessMobil      Boolean @default(false) @map("access_mobil")

  role Role @relation(fields: [roleId], references: [idRole], onDelete: Restrict)
  permintaan Permintaan[]
  sementara Sementara[]
  pengajuan Pengajuan[]
  pengajuanSementara PengajuanSementara[]
  pemasukan Pemasukan[]
  pengeluaran Pengeluaran[]
  laporanKm MobilLaporanKm[]
  itmsTicketsRequested ItmsTicket[] @relation("ItmsTicketRequester")
  itmsTicketsAssigned  ItmsTicket[] @relation("ItmsTicketAssignee")
  itmsTicketComments   ItmsTicketComment[]
  itmsTicketEvents     ItmsTicketEvent[]
  itmsKbOwned          ItmsKbDocument[] @relation("ItmsKbOwner")
  itmsKbVersionsAuthored ItmsKbVersion[] @relation("ItmsKbVersionAuthor")
  itmsKbVersionsApproved ItmsKbVersion[] @relation("ItmsKbVersionApprover")
  itmsKbAcknowledgments  ItmsKbAcknowledgment[]
  itmsAssetsHeld         ItmsAsset[] @relation("ItmsAssetHolder")
  itmsAssetAssignments   ItmsAssetAssignment[]
  itmsNotifications      ItmsNotification[]

  @@index([roleId])
  @@map("user")
}

enum UserLevel {
  user
  administrator
  it_support
  purchasing
}

model JenisBarang {
  idJenis   Int    @id @default(autoincrement()) @map("id_jenis")
  jenisBrg  String @map("jenis_brg") @db.VarChar(255)

  stokbarang Stokbarang[]

  @@map("atk_jenis_barang")
}

model Stokbarang {
  idKodeBrg   Int    @id @default(autoincrement()) @map("id_kode_brg")
  kodeBrg     String @unique @map("kode_brg") @db.VarChar(7)
  idJenis     Int    @map("id_jenis")
  namaBrg     String @map("nama_brg") @db.VarChar(50)
  hargabarang String @db.VarChar(50)
  satuan      String @db.VarChar(50)
  stok        Int
  keluar      Int    @default(0)
  sisa        Int    @default(0)
  keterangan  String @default("") @db.VarChar(50)

  jenisBarang JenisBarang @relation(fields: [idJenis], references: [idJenis], onDelete: Restrict)
  permintaan  Permintaan[]
  pengajuan   Pengajuan[]
  pengajuanSementara PengajuanSementara[]
  sementara   Sementara[]
  pemasukan   Pemasukan[]
  pengeluaran Pengeluaran[]

  @@map("atk_stokbarang")
}

model Permintaan {
  idPermintaan  Int      @id @default(autoincrement()) @map("id_permintaan")
  idUser        Int      @map("id_user")
  kodeBrg       String   @map("kode_brg") @db.VarChar(7)
  jumlah        Int
  tglPermintaan DateTime @map("tgl_permintaan") @db.Date
  status        Int      @default(0)

  pemohon    User       @relation(fields: [idUser], references: [idUser], onDelete: Restrict)
  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_permintaan")
  @@index([idUser, tglPermintaan])
  @@index([status])
}

model Sementara {
  idSementara   Int      @id @default(autoincrement()) @map("id_sementara")
  idUser        Int      @map("id_user")
  kodeBrg       String   @map("kode_brg") @db.VarChar(7)
  jumlah        Int
  tglPermintaan DateTime @map("tgl_permintaan") @db.Date
  status        Int      @default(0)

  pemohon    User       @relation(fields: [idUser], references: [idUser], onDelete: Restrict)
  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_sementara")
  @@index([idUser, tglPermintaan])
}

model Pengajuan {
  idPengajuan  Int      @id @default(autoincrement()) @map("id_pengajuan")
  idUser       Int      @map("id_user")
  kodeBrg      String   @map("kode_brg") @db.VarChar(7)
  jumlah       Int
  satuan       String   @db.VarChar(11)
  hargabarang  Float    @db.DoublePrecision
  total        Float    @db.DoublePrecision
  tglPengajuan DateTime @map("tgl_pengajuan") @db.Date
  status       Int      @default(0)

  pemohon    User       @relation(fields: [idUser], references: [idUser], onDelete: Restrict)
  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_pengajuan")
  @@index([idUser, tglPengajuan])
  @@index([status])
}

model PengajuanSementara {
  idPengajuanSementara Int      @id @default(autoincrement()) @map("id_pengajuan_sementara")
  idUser               Int      @map("id_user")
  kodeBrg              String   @map("kode_brg") @db.VarChar(7)
  jumlah               Int
  satuan               String   @db.VarChar(20)
  hargabarang          Float    @db.DoublePrecision
  total                Float    @db.DoublePrecision
  tglPengajuan         DateTime @map("tgl_pengajuan") @db.Date
  status               Int      @default(0)

  pemohon    User       @relation(fields: [idUser], references: [idUser], onDelete: Restrict)
  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_pengajuan_sementara")
  @@index([idUser, tglPengajuan])
}

model Pemasukan {
  id       Int      @id @default(autoincrement())
  idUser   Int      @map("id_user")
  kodeBrg  String   @map("kode_brg") @db.VarChar(7)
  jumlah   Int
  tglMasuk DateTime @map("tgl_masuk") @db.Date

  pemohon    User       @relation(fields: [idUser], references: [idUser], onDelete: Restrict)
  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_pemasukan")
  @@index([tglMasuk])
  @@index([idUser])
}

model Pengeluaran {
  id        Int      @id @default(autoincrement())
  idUser    Int      @map("id_user")
  kodeBrg   String   @map("kode_brg") @db.VarChar(7)
  jumlah    Int
  tglKeluar DateTime @map("tgl_keluar") @db.Date

  pemohon    User       @relation(fields: [idUser], references: [idUser], onDelete: Restrict)
  stokbarang Stokbarang @relation(fields: [kodeBrg], references: [kodeBrg])

  @@map("atk_pengeluaran")
  @@index([tglKeluar])
  @@index([idUser])
}

// ─── ITMS (IT Management System) ───

enum ItmsTicketType {
  incident
  service_request
}

enum ItmsTicketStatus {
  new
  assigned
  in_progress
  pending
  resolved
  closed
  cancelled
}

enum ItmsPriority {
  p1
  p2
  p3
  p4
}

enum ItmsImpact {
  high
  medium
  low
}

enum ItmsUrgency {
  high
  medium
  low
}

model ItmsCategory {
  idCategory      Int      @id @default(autoincrement()) @map("id_category")
  name            String   @db.VarChar(100)
  parentId        Int?     @map("parent_id")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  parent   ItmsCategory?  @relation("ItmsCategoryTree", fields: [parentId], references: [idCategory], onDelete: SetNull)
  children ItmsCategory[] @relation("ItmsCategoryTree")
  tickets  ItmsTicket[]

  @@map("itms_category")
  @@index([parentId])
  @@index([active])
}

model ItmsSlaPolicy {
  idPolicy           Int          @id @default(autoincrement()) @map("id_policy")
  priority           ItmsPriority @unique
  responseMinutes    Int          @map("response_minutes")
  resolutionMinutes  Int          @map("resolution_minutes")
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  tickets ItmsTicket[]

  @@map("itms_sla_policy")
}

model ItmsTicket {
  idTicket          Int              @id @default(autoincrement()) @map("id_ticket")
  number            String           @unique @db.VarChar(32)
  type              ItmsTicketType   @default(incident)
  title             String           @db.VarChar(200)
  description       String           @db.Text
  idCategory        Int              @map("id_category")
  impact            ItmsImpact       @default(low)
  urgency           ItmsUrgency      @default(low)
  priority          ItmsPriority     @default(p4)
  status            ItmsTicketStatus @default(new)
  idRequester       Int              @map("id_requester")
  idAssignee        Int?             @map("id_assignee")
  idSlaPolicy       Int?             @map("id_sla_policy")
  idAsset           Int?             @map("id_asset")
  idKbDocument      Int?             @map("id_kb_document")
  dueResponseAt     DateTime?        @map("due_response_at")
  dueResolutionAt   DateTime?        @map("due_resolution_at")
  firstRespondedAt  DateTime?        @map("first_responded_at")
  resolvedAt        DateTime?        @map("resolved_at")
  closedAt          DateTime?        @map("closed_at")
  pendingStartedAt  DateTime?        @map("pending_started_at")
  slaPausedMinutes  Int              @default(0) @map("sla_paused_minutes")
  csatScore         Int?             @map("csat_score")
  csatComment       String?          @map("csat_comment") @db.VarChar(500)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  category   ItmsCategory       @relation(fields: [idCategory], references: [idCategory])
  requester  User               @relation("ItmsTicketRequester", fields: [idRequester], references: [idUser], onDelete: Restrict)
  assignee   User?              @relation("ItmsTicketAssignee", fields: [idAssignee], references: [idUser], onDelete: Restrict)
  slaPolicy  ItmsSlaPolicy?     @relation(fields: [idSlaPolicy], references: [idPolicy], onDelete: SetNull)
  asset      ItmsAsset?         @relation(fields: [idAsset], references: [idAsset], onDelete: SetNull)
  kbDocument ItmsKbDocument?    @relation(fields: [idKbDocument], references: [idDocument], onDelete: SetNull)
  comments   ItmsTicketComment[]
  events     ItmsTicketEvent[]

  @@map("itms_ticket")
  @@index([idRequester])
  @@index([idAssignee])
  @@index([status])
  @@index([priority])
  @@index([idCategory])
  @@index([idAsset])
  @@index([idKbDocument])
  @@index([createdAt])
  @@index([dueResolutionAt])
}

model ItmsTicketComment {
  idComment  Int      @id @default(autoincrement()) @map("id_comment")
  idTicket   Int      @map("id_ticket")
  idAuthor   Int      @map("id_author")
  body       String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket ItmsTicket @relation(fields: [idTicket], references: [idTicket], onDelete: Cascade)
  author User       @relation(fields: [idAuthor], references: [idUser], onDelete: Restrict)

  @@map("itms_ticket_comment")
  @@index([idTicket])
  @@index([idAuthor])
}

model ItmsTicketEvent {
  idEvent   Int      @id @default(autoincrement()) @map("id_event")
  idTicket  Int      @map("id_ticket")
  idActor   Int?     @map("id_actor")
  type      String   @db.VarChar(50)
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  ticket ItmsTicket @relation(fields: [idTicket], references: [idTicket], onDelete: Cascade)
  actor  User?      @relation(fields: [idActor], references: [idUser], onDelete: SetNull)

  @@map("itms_ticket_event")
  @@index([idTicket])
  @@index([createdAt])
}

enum ItmsKbKind {
  sop
  article
}

enum ItmsKbStatus {
  draft
  in_review
  published
  archived
}

enum ItmsKbVisibility {
  internal_all
  it_only
}

model ItmsKbDocument {
  idDocument       Int              @id @default(autoincrement()) @map("id_document")
  kind             ItmsKbKind
  number           String?          @db.VarChar(40)
  title            String           @db.VarChar(200)
  idOwner          Int              @map("id_owner")
  status           ItmsKbStatus     @default(draft)
  visibility       ItmsKbVisibility @default(internal_all)
  idCurrentVersion Int?             @unique @map("id_current_version")
  effectiveDate    DateTime?        @map("effective_date") @db.Date
  nextReviewAt     DateTime?        @map("next_review_at") @db.Date
  tags             String           @default("") @db.VarChar(255)
  helpfulYes       Int              @default(0) @map("helpful_yes")
  helpfulNo        Int              @default(0) @map("helpful_no")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  owner          User              @relation("ItmsKbOwner", fields: [idOwner], references: [idUser], onDelete: Restrict)
  currentVersion ItmsKbVersion?    @relation("ItmsKbCurrentVersion", fields: [idCurrentVersion], references: [idVersion], onDelete: SetNull)
  versions       ItmsKbVersion[]   @relation("ItmsKbDocumentVersions")
  acknowledgments ItmsKbAcknowledgment[]
  tickets        ItmsTicket[]

  @@map("itms_kb_document")
  @@index([kind])
  @@index([status])
  @@index([idOwner])
  @@index([title])
}

model ItmsKbVersion {
  idVersion    Int      @id @default(autoincrement()) @map("id_version")
  idDocument   Int      @map("id_document")
  version      Int
  body         String   @db.Text
  changeNote   String   @default("") @map("change_note") @db.VarChar(255)
  idAuthor     Int      @map("id_author")
  idApprovedBy Int?     @map("id_approved_by")
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime @default(now()) @map("created_at")

  document   ItmsKbDocument @relation("ItmsKbDocumentVersions", fields: [idDocument], references: [idDocument], onDelete: Cascade)
  author     User           @relation("ItmsKbVersionAuthor", fields: [idAuthor], references: [idUser], onDelete: Restrict)
  approvedBy User?          @relation("ItmsKbVersionApprover", fields: [idApprovedBy], references: [idUser], onDelete: SetNull)
  currentFor ItmsKbDocument? @relation("ItmsKbCurrentVersion")
  acknowledgments ItmsKbAcknowledgment[]

  @@unique([idDocument, version])
  @@map("itms_kb_version")
  @@index([idDocument])
  @@index([idAuthor])
}

model ItmsKbAcknowledgment {
  idAck        Int      @id @default(autoincrement()) @map("id_ack")
  idVersion    Int      @map("id_version")
  idDocument   Int      @map("id_document")
  idUser       Int      @map("id_user")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  version  ItmsKbVersion  @relation(fields: [idVersion], references: [idVersion], onDelete: Cascade)
  document ItmsKbDocument @relation(fields: [idDocument], references: [idDocument], onDelete: Cascade)
  user     User           @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@unique([idVersion, idUser])
  @@map("itms_kb_acknowledgment")
  @@index([idDocument])
  @@index([idUser])
}

enum ItmsAssetStatus {
  in_stock
  assigned
  in_repair
  retired
  disposed
  lost
}

model ItmsAsset {
  idAsset       Int             @id @default(autoincrement()) @map("id_asset")
  tag           String          @unique @db.VarChar(40)
  type          String          @db.VarChar(50)
  serialNumber  String?         @map("serial_number") @db.VarChar(100)
  brand         String          @default("") @db.VarChar(80)
  model         String          @default("") @db.VarChar(80)
  specs         String          @default("") @db.Text
  purchaseDate  DateTime?       @map("purchase_date") @db.Date
  purchasePrice Decimal?        @map("purchase_price") @db.Decimal(14, 2)
  vendor        String          @default("") @db.VarChar(100)
  warrantyUntil DateTime?       @map("warranty_until") @db.Date
  location      String          @default("") @db.VarChar(100)
  status        ItmsAssetStatus @default(in_stock)
  idHolder      Int?            @map("id_holder")
  notes         String          @default("") @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  holder      User?                 @relation("ItmsAssetHolder", fields: [idHolder], references: [idUser], onDelete: SetNull)
  assignments ItmsAssetAssignment[]
  tickets     ItmsTicket[]

  @@map("itms_asset")
  @@index([type])
  @@index([status])
  @@index([idHolder])
  @@index([warrantyUntil])
}

model ItmsAssetAssignment {
  idAssignment  Int       @id @default(autoincrement()) @map("id_assignment")
  idAsset       Int       @map("id_asset")
  idUser        Int       @map("id_user")
  assignedAt    DateTime  @default(now()) @map("assigned_at")
  returnedAt    DateTime? @map("returned_at")
  conditionNote String    @default("") @map("condition_note") @db.VarChar(255)

  asset ItmsAsset @relation(fields: [idAsset], references: [idAsset], onDelete: Cascade)
  user  User      @relation(fields: [idUser], references: [idUser], onDelete: Restrict)

  @@map("itms_asset_assignment")
  @@index([idAsset])
  @@index([idUser])
  @@index([returnedAt])
}

model ItmsNotification {
  idNotification Int       @id @default(autoincrement()) @map("id_notification")
  idUser         Int       @map("id_user")
  type           String    @db.VarChar(50)
  title          String    @db.VarChar(200)
  body           String    @db.VarChar(500)
  href           String?   @db.VarChar(255)
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@map("itms_notification")
  @@index([idUser, readAt])
  @@index([createdAt])
}

model MobilJenis {
  idJenis     Int    @id @default(autoincrement()) @map("id_jenis")
  nama        String @db.VarChar(100)
  keterangan  String @default("") @db.VarChar(255)

  kendaraan MobilKendaraan[]

  @@map("mobil_jenis")
}

model MobilKendaraan {
  idKendaraan Int      @id @default(autoincrement()) @map("id_kendaraan")
  nopol       String   @unique @db.VarChar(20)
  idJenis     Int      @map("id_jenis")
  kmAwal      Int      @default(0) @map("km_awal")
  aktif       Boolean  @default(true)
  tglDibuat   DateTime @default(now()) @map("tgl_dibuat")
  tglDiupdate DateTime @updatedAt @map("tgl_diupdate")

  jenis   MobilJenis       @relation(fields: [idJenis], references: [idJenis], onDelete: Restrict)
  laporan MobilLaporanKm[]

  @@map("mobil_kendaraan")
  @@index([idJenis])
  @@index([aktif])
}

model MobilLaporanKm {
  idLaporan   Int      @id @default(autoincrement()) @map("id_laporan")
  idKendaraan Int      @map("id_kendaraan")
  idUser      Int      @map("id_user")
  tanggal     DateTime @db.Date
  kmAwal      Int      @map("km_awal")
  kmAkhir     Int      @map("km_akhir")
  uangJalan   Int      @default(0) @map("uang_jalan")
  tglDibuat   DateTime @default(now()) @map("tgl_dibuat")
  tglDiupdate DateTime @updatedAt @map("tgl_diupdate")

  pemohon    User                     @relation(fields: [idUser], references: [idUser], onDelete: Restrict)
  kendaraan  MobilKendaraan           @relation(fields: [idKendaraan], references: [idKendaraan], onDelete: Restrict)
  perjalanan MobilLaporanPerjalanan[]

  @@unique([idKendaraan, tanggal])
  @@map("mobil_laporan_km")
  @@index([idUser])
  @@index([tanggal])
  @@index([idKendaraan])
}

model MobilLaporanPerjalanan {
  idPerjalanan Int    @id @default(autoincrement()) @map("id_perjalanan")
  idLaporan    Int    @map("id_laporan")
  urutan       Int
  dari         String @db.VarChar(100)
  jamDari      String @map("jam_dari") @db.VarChar(5)
  ke           String @db.VarChar(100)
  jamKe        String @map("jam_ke") @db.VarChar(5)
  km           Int
  tol          Int    @default(0)
  buktiPath    String? @map("bukti_path") @db.VarChar(255)

  laporan MobilLaporanKm @relation(fields: [idLaporan], references: [idLaporan], onDelete: Cascade)

  @@map("mobil_laporan_perjalanan")
  @@index([idLaporan])
  @@unique([idLaporan, urutan])
}
