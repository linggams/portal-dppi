# Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/atk?schema=public"

# NextAuth
NEXTAUTH_SECRET="ganti-dengan-secret-acak"
# Untuk Auth.js v5: trust host agar bisa mengikuti IP/domain dari request
AUTH_TRUST_HOST="true"

# NEXTAUTH_URL tidak wajib di-set agar auth mengikuti origin request secara otomatis.
# Kalau ada masalah, set sesuai environment:
# Dev:  NEXTAUTH_URL="http://localhost:2000"
# Prod: NEXTAUTH_URL="http://IP-SERVER" atau "https://domain-anda.com"
